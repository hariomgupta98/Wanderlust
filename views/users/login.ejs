<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <h2 class="col-6 offset-5 mt-2">Login in Wanderlust</h2>
        <div class="col-6 offset-3 mt-4">
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <lable for="username" class="form-label">Username</lable>
                    <input name="username" id="username" placeholder="Enter Username" type="text" class="form-control"
                        required />
                </div>
                <div class="mb-3">
                    <lable for="password" class="form-label">Password</lable>
                    <input name="password" id="password" placeholder="Enter Password" type="password"
                        class="form-control" required />
                </div>
                <button class="btn btn-outline-success">Login</button>
            </form>
        </div>
    </div>